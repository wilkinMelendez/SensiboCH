<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mismo esquema que los ejemplos "SDK-style" del Crestron Drivers SDK 29 -->
  <PropertyGroup>
    <TargetFrameworks>net47</TargetFrameworks>
    <AssemblyName>ExtensionDevice_Sensibo_Thermostat_Cloud</AssemblyName>
    <RootNamespace>SensiboCrestronHome</RootNamespace>
    <LangVersion>3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>false</Deterministic>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <CrestronDevKitVersion Condition="'$(CrestronDevKitVersion)' == ''">29.0.10</CrestronDevKitVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="$(CrestronDevKitVersion)" />
    <!-- DevKit excluye SimplSharp de la compilación; se referencia directo para CTimer, HttpsClient, ErrorLog y Newtonsoft (SimplSharpNewtonsoft).
         Sus targets de build (empaquetado .clz para programas SIMPL#) no aplican a drivers. -->
    <PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.22.40" ExcludeAssets="build" />
    <PackageReference Include="Crestron.DeviceDrivers.ManifestUtil" Version="29.0.10" Condition="'$(SkipManifestUtilPackage)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ExtensionDevice_Sensibo_Thermostat_Cloud.json" />
    <None Include="IncludeInPkg\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
